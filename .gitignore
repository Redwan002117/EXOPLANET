*.py[cod]
*.pyd
.pytest_cache/

# Trained model artefacts. saved_models/ IS tracked (checkpoints are part of the
# deliverable). Transient joblib/pickle dumps outside it stay ignored.
*.joblib
*.pkl
*.onnx

# results/ and saved_models/ are both tracked: per-star JSON findings and the
# trained checkpoints that produced them.

# LibreOffice temp + lock files (left behind by headless doc conversion)
.~lock.*
lu*.tmp

# Local scratch backups from the pipeline/prototype rewrite
BACKUP_*
BACKUP3_*

